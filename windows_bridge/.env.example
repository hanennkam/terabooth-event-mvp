# Terabooth Windows Bridge example configuration.
# MockPrinter is the safe default. Do not switch to spooler without explicit
# physical-print authorization and a reviewed printer preflight.
TERABOOTH_PRINTER=mock
TERABOOTH_PRINTER_NAME=DS-RX1
TERABOOTH_HOST=0.0.0.0
TERABOOTH_PORT=8787
TERABOOTH_DATA_DIR=data
TERABOOTH_PUBLIC_BASE_URL=http://<windows-lan-ip>:8787
# Generate unique values; never commit real secrets.
TERABOOTH_API_TOKEN=replace-with-long-random-token
TERABOOTH_DELIVERY_SECRET=replace-with-long-random-secret
