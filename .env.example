# Copy to windows_bridge/.env (run_windows.ps1 loads it).
# Set real values for the event. Do not commit the real .env.

# mock | spooler | hotfolder. Use spooler or hotfolder at the event.
TERABOOTH_PRINTER=mock
TERABOOTH_PRINTER_NAME=DNP DS-RX1HS

# Must match the iPad build --dart-define, or leave empty.
TERABOOTH_API_TOKEN=change-me
TERABOOTH_DELIVERY_SECRET=change-me-long-random

# Actual Windows LAN IP, not localhost.
TERABOOTH_PUBLIC_BASE_URL=http://192.168.8.50:8787
TERABOOTH_DATA_DIR=./data
# Optional separate asset root; defaults to <data>/jobs.
# TERABOOTH_ASSETS_DIR=C:\Terabooth\assets
TERABOOTH_HOST=0.0.0.0
TERABOOTH_PORT=8787
TERABOOTH_TOKEN_TTL_HOURS=24
TERABOOTH_JOB_TIMEOUT_SECONDS=60

# Optional DNP Hot Folder Print path:
# TERABOOTH_HOT_FOLDER=C:\DNP\HFP\4x6
# TERABOOTH_HOT_FOLDER_ARCHIVE=C:\DNP\HFP\archive
